{
  "name": "retiros-holisticos-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "catalog": "python3 contenido/scripts/build_catalog.py src/data docs/datos && npm run catalog:demo && npm run seed",
    "catalog:demo": "esbuild scripts/make-demo-catalog.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/make-demo.mjs --log-level=warning && node node_modules/.cache/make-demo.mjs",
    "seed": "node scripts/generar-seed.mjs",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && VITE_DATA_MODE=supabase vite build",
    "build:demo": "tsc --noEmit && VITE_DATA_MODE=demo vite build --outDir dist-demo",
    "build:artifact": "vite build --mode artifact && node scripts/make-artifact.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:db": "node tests/db/run-db-tests.mjs",
    "test:e2e": "node tests/e2e/run-e2e.mjs",
    "test:todo": "npm run typecheck && npm test && npm run test:db && npm run build:artifact && npm run test:e2e",
    "build:local": "tsc --noEmit && VITE_DATA_MODE=local vite build --outDir dist-local"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "jsdom": "^25.0.1",
    "pg": "^8.13.1",
    "playwright": "^1.48.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-singlefile": "^2.0.3",
    "vitest": "^2.1.4"
  }
}